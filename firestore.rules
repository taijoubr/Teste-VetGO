rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Health-check / test connection document
    match /test/{docId} {
      allow read, write: if isValidId(docId);
    }

    // Master cloud sync for container redeployments
    match /vetgo_cloud_db/{docId} {
      allow read, write: if isValidId(docId);
    }

    // Users Collection
    match /users/{userId} {
      allow get, list: if isValidId(userId);
      allow create, update: if isValidId(userId) && incoming().email is string;
      allow delete: if isValidId(userId);
    }

    // Partner Clinics
    match /clinics/{clinicId} {
      allow get, list: if isValidId(clinicId);
      allow create: if isValidId(clinicId) && incoming().name is string && incoming().name.size() <= 200;
      allow update, delete: if isValidId(clinicId);
    }

    // Partner Surgeons
    match /surgeons/{surgeonId} {
      allow get, list: if isValidId(surgeonId);
      allow create: if isValidId(surgeonId) && incoming().name is string && incoming().name.size() <= 200;
      allow update, delete: if isValidId(surgeonId);
    }

    // Tutors
    match /tutors/{tutorId} {
      allow get, list: if isValidId(tutorId);
      allow create: if isValidId(tutorId) && incoming().name is string && incoming().name.size() <= 200;
      allow update, delete: if isValidId(tutorId);
    }

    // Patients
    match /patients/{patientId} {
      allow get, list: if isValidId(patientId);
      allow create: if isValidId(patientId) && incoming().name is string && incoming().name.size() <= 200;
      allow update, delete: if isValidId(patientId);
    }

    // Anesthesia Records
    match /anesthesias/{anesthesiaId} {
      allow get, list: if isValidId(anesthesiaId);
      allow create: if isValidId(anesthesiaId) && incoming().procedure_name is string && incoming().procedure_name.size() <= 300;
      allow update, delete: if isValidId(anesthesiaId);
    }

    // Appointments
    match /appointments/{appointmentId} {
      allow get, list: if isValidId(appointmentId);
      allow create: if isValidId(appointmentId) && incoming().title is string && incoming().title.size() <= 200;
      allow update, delete: if isValidId(appointmentId);
    }

    // Financial Entries
    match /financial_entries/{entryId} {
      allow get, list: if isValidId(entryId);
      allow create: if isValidId(entryId) && incoming().description is string && incoming().description.size() <= 250;
      allow update, delete: if isValidId(entryId);
    }

    // Inventory Items
    match /inventory_items/{itemId} {
      allow get, list: if isValidId(itemId);
      allow create: if isValidId(itemId) && incoming().name is string && incoming().name.size() <= 200;
      allow update, delete: if isValidId(itemId);
    }

    // Consultations
    match /consultations/{consultationId} {
      allow get, list: if isValidId(consultationId);
      allow create: if isValidId(consultationId) && incoming().patient_id is string;
      allow update, delete: if isValidId(consultationId);
    }

    // Documents
    match /documents/{docId} {
      allow get, list: if isValidId(docId);
      allow create: if isValidId(docId) && incoming().title is string && incoming().title.size() <= 200;
      allow update, delete: if isValidId(docId);
    }
  }
}
