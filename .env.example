# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GMAIL SMTP CONFIGURATION (Envio gratuito de e-mails de validação de cadastro):
# Configure seu endereço do Gmail e a Senha de Aplicativo (16 dígitos) gerada em:
# https://myaccount.google.com/apppasswords
GMAIL_USER="seu-email@gmail.com"
GMAIL_APP_PASSWORD="sua-senha-de-app-16-digitos"
EMAIL_FROM="Vetgo <seu-email@gmail.com>"

# WEB PUSH NOTIFICATIONS (VAPID):
VAPID_PUBLIC_KEY="BJ6odgcVdtdhTv8cqMaDF-WM5Nd2K2ggKFgduUUw1vsXMqXwW4-TtNmx5jV19NvDSkG9GmUq96dB3tkXdriDveY"
VAPID_PRIVATE_KEY="NXUjd49OYZNKSRnaZ8N6WGN48mnMh8ufLFtzBmtIHQY"
VAPID_SUBJECT="mailto:contato@vetgo.com.br"

# GOOGLE AUTHENTICATION (Sign in with Google):
# Obtenha seu Client ID em: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID="916489101501-qc2u92j7nhj0ou9j5et1frfu912eve3k.apps.googleusercontent.com"


